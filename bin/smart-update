#!/usr/bin/env bash

set -Eeuo pipefail
umask 027

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly SCRIPT_DIR

PROJECT_ROOT=$(cd -- "${SCRIPT_DIR}/.." && pwd)
readonly PROJECT_ROOT

readonly CONFIG_FILE="${PROJECT_ROOT}/config/smart-update.conf"
readonly CONFIG_MODULE="${PROJECT_ROOT}/lib/config.sh"
readonly LOGGER_MODULE="${PROJECT_ROOT}/lib/logger.sh"
readonly DECISION_MODULE="${PROJECT_ROOT}/lib/decision.sh"
readonly SYSTEM_CHECKS_MODULE="${PROJECT_ROOT}/lib/system_checks.sh"
readonly REPORT_MODULE="${PROJECT_ROOT}/lib/report.sh"
readonly ENGINE_MODULE="${PROJECT_ROOT}/lib/engine.sh"
readonly LOCK_FILE="/run/lock/smart-update.lock"
readonly STATE_DIR="/var/lib/smart-update"
readonly LAST_SUCCESS_FILE="${STATE_DIR}/last-success"

if [[ ! -r "$CONFIG_MODULE" ]]; then
    printf 'Module de configuration absent : %s\n' "$CONFIG_MODULE" >&2
    exit 1
fi

if [[ ! -r "$LOGGER_MODULE" ]]; then
    printf 'Module de journalisation absent : %s\n' "$LOGGER_MODULE" >&2
    exit 1
fi

if [[ ! -r "$DECISION_MODULE" ]]; then
    printf 'Module de décision absent : %s\n' "$DECISION_MODULE" >&2
    exit 1
fi

if [[ ! -r "$SYSTEM_CHECKS_MODULE" ]]; then
    printf 'Module des contrôles système absent : %s\n' "$SYSTEM_CHECKS_MODULE" >&2
    exit 1
fi

if [[ ! -r "$REPORT_MODULE" ]]; then
    printf 'Module de rapports absent : %s\n' "$REPORT_MODULE" >&2
    exit 1
fi

if [[ ! -r "$ENGINE_MODULE" ]]; then
    printf 'Module moteur absent : %s\n' "$ENGINE_MODULE" >&2
    exit 1
fi

# shellcheck source=lib/config.sh
source "${PROJECT_ROOT}/lib/config.sh"

# shellcheck source=lib/logger.sh
source "${PROJECT_ROOT}/lib/logger.sh"

# shellcheck source=lib/decision.sh
source "${PROJECT_ROOT}/lib/decision.sh"

# shellcheck source=lib/system_checks.sh
source "${PROJECT_ROOT}/lib/system_checks.sh"

# shellcheck source=lib/report.sh
source "${PROJECT_ROOT}/lib/report.sh"

# shellcheck source=lib/engine.sh
source "${PROJECT_ROOT}/lib/engine.sh"

decision_reset

config_load "$CONFIG_FILE"

install -d -m 0750 "$STATE_DIR"
mkdir -p "$REPORT_DIR"
touch "$LOG_FILE" "$BLOCKED_LOG"
chmod 640 "$LOG_FILE" "$BLOCKED_LOG"

exec 9>"$LOCK_FILE"

if ! flock -n 9; then
    decision_add "BLOCK" "Une autre instance de Smart Update est déjà active."
    logger_blocked "${DECISION_REASONS[-1]}"
    exit 20
fi

trap 'logger_error "Erreur ligne ${LINENO} : ${BASH_COMMAND}"' ERR

declare -a UPDATE_LINES=()
declare -a UPDATE_PACKAGES=()
declare -a CRITICAL_UPDATES=()

load_updates() {
    local output
    local status

    logger_info "Recherche sécurisée des mises à jour."

    set +e
    output=$(checkupdates 2>&1)
    status=$?
    set -e

    case "$status" in
        0)
            mapfile -t UPDATE_LINES <<<"$output"
            ;;

        2)
            logger_info "Aucune mise à jour disponible."
            exit 0
            ;;

        *)
            logger_error "Échec de checkupdates :"
            printf '%s\n' "$output" | tee -a "$LOG_FILE"
            exit 21
            ;;
    esac

    local line
    local package_name

    for line in "${UPDATE_LINES[@]}"; do
        package_name=${line%% *}
        UPDATE_PACKAGES+=("$package_name")
    done

    logger_info "${#UPDATE_PACKAGES[@]} mise(s) à jour détectée(s)."

    printf '%s\n' "${UPDATE_LINES[@]}" \
        | tee -a "$LOG_FILE"
}

check_arch_news() {
    [[ "$CHECK_ARCH_NEWS" == "yes" ]] || return 0

    logger_info "Consultation des dernières annonces Arch Linux."

    local news
    news=$(
        curl \
            --fail \
            --silent \
            --show-error \
            --max-time 20 \
            "https://archlinux.org/feeds/news/" \
            || true
    )

    if [[ -z "$news" ]]; then
        decision_add \
            "BLOCK" \
            "Impossible de consulter les annonces Arch Linux."

        logger_blocked "${DECISION_REASONS[-1]}"
        exit 24
    fi

    local recent_titles
    recent_titles=$(
        printf '%s\n' "$news" \
            | grep -o '<title>[^<]*</title>' \
            | sed -e 's/<title>//' -e 's#</title>##' \
            | tail -n +2 \
            | head -n "$ARCH_NEWS_LIMIT"
    )

    {
        echo
        echo "Dernières annonces Arch consultées :"
        printf '%s\n' "$recent_titles"
        echo
    } >>"$LOG_FILE"

    decision_add \
        "WARNING" \
        "Les annonces ont été consignées dans le journal."

    logger_warning "${DECISION_REASONS[-1]}"

    decision_add \
        "WARNING" \
        "La détection automatique ne remplace pas leur lecture humaine."

    logger_warning "${DECISION_REASONS[-1]}"
}

simulate_transaction() {
    logger_info "Simulation de la transaction Pacman."

    local simulation
    local status
    local planned_file
    local installed_file
    local new_packages_file

    planned_file=$(mktemp)
    installed_file=$(mktemp)
    new_packages_file=$(mktemp)

    set +e
    simulation=$(
        LC_ALL=C pacman -Syu \
            --print \
            --print-format '%n %v %r' 2>&1
    )
    status=$?
    set -e

    if ((status != 0)); then
        decision_add \
            "BLOCK" \
            "La simulation Pacman a échoué."

        logger_blocked "${DECISION_REASONS[-1]}"

        printf '%s
' "$simulation" \
            | tee -a "$LOG_FILE" "$BLOCKED_LOG"

        rm -f "$planned_file" "$installed_file" "$new_packages_file"
        exit 25
    fi

    printf '%s
' "$simulation" \
        | awk 'NF == 3 && $1 ~ /^[a-zA-Z0-9@._+:-]+$/ {print $1}' \
        | sort -u >"$planned_file"

    pacman -Qq \
        | sort -u >"$installed_file"

    comm -13 "$installed_file" "$planned_file" >"$new_packages_file"

    {
        echo
        echo "Simulation de transaction :"
        printf '%s
' "$simulation"
        echo
    } >>"$LOG_FILE"

    mapfile -t NEW_PACKAGES <"$new_packages_file"

    if ((${#NEW_PACKAGES[@]} > 0)); then
        if [[ "$ALLOW_NEW_DEPENDENCIES" == "yes" ]]; then
            decision_add \
                "WARNING" \
                "Nouveaux paquets ou nouvelles dépendances détectés :"

            logger_warning "${DECISION_REASONS[-1]}"

            printf '%s\n' "${NEW_PACKAGES[@]}" \
                | tee -a "$LOG_FILE"
        else
            decision_add \
                "BLOCK" \
                "Nouveaux paquets ou nouvelles dépendances détectés :"

            logger_blocked "${DECISION_REASONS[-1]}"

            printf '%s\n' "${NEW_PACKAGES[@]}" \
                | tee -a "$LOG_FILE" "$BLOCKED_LOG"

            if [[ "$MODE" == "audit" ]]; then
                decision_add \
                    "WARNING" \
                    "Mode audit : nouveaux paquets signalés sans installation."

                logger_warning "${DECISION_REASONS[-1]}"
            fi
        fi
    else
        logger_info "Aucun nouveau paquet détecté dans la transaction."
    fi

    rm -f "$planned_file" "$installed_file" "$new_packages_file"
}

enforce_final_decision() {
    local gate_status

    if decision_allows_installation; then
        return 0
    else
        gate_status=$?
    fi

    case "$gate_status" in
        1)
            logger_blocked \
                "Installation interdite par la décision finale BLOCK."

            report_finalize
            exit 29
            ;;

        *)
            logger_error \
                "Décision finale invalide : ${DECISION_FINAL:-undefined}."

            report_finalize
            exit 30
            ;;
    esac
}

install_updates() {
    if [[ "$MODE" == "audit" ]]; then
        logger_info "Mode audit : aucune installation effectuée."
        return 0
    fi

    if [[ "$MODE" != "guarded" ]]; then
        decision_add \
            "BLOCK" \
            "Mode inconnu dans la configuration : ${MODE}"

        logger_blocked "${DECISION_REASONS[-1]}"
        exit 28
    fi

    logger_info "Installation de la mise à jour complète des dépôts officiels."

    # L’entrée standard est fermée afin qu’aucune question inattendue
    # ne soit automatiquement acceptée.

    if ! pacman -Syu --needed </dev/null 2>&1 \
        | tee -a "$LOG_FILE"; then

        decision_add \
            "BLOCK" \
            "Pacman a interrompu ou refusé la transaction."

        logger_blocked "${DECISION_REASONS[-1]}"
        exit 26
    fi

    date --iso-8601=seconds >"$LAST_SUCCESS_FILE"
    chmod 640 "$LAST_SUCCESS_FILE"

    logger_info "Mise à jour terminée avec succès."
}

main() {
    require_root
    check_required_commands
    cleanup_old_reports
    check_network
    check_pacman_lock
    check_root_space
    create_report

    load_updates

    engine_load_policies
    engine_run_policies

    check_arch_news
    simulate_transaction
    enforce_final_decision
    install_updates
    report_finalize
}

main "$@"
