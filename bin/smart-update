#!/usr/bin/env bash

set -Eeuo pipefail
umask 027

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly SCRIPT_DIR

# Smart Update supporte deux layouts :
# - développement : <repo>/bin/smart-update + <repo>/lib + <repo>/config
# - système      : /usr/bin/smart-update + /usr/lib/smart-update + /etc/smart-update
if [[ -r "${SCRIPT_DIR}/../lib/config.sh" ]]; then
    PROJECT_ROOT=$(cd -- "${SCRIPT_DIR}/.." && pwd)
    LIB_DIR="${PROJECT_ROOT}/lib"
    CONFIG_DIR="${PROJECT_ROOT}/config"
    TOOLS_DIR="${PROJECT_ROOT}/tools"
else
    PROJECT_ROOT="/usr/lib/smart-update"
    LIB_DIR="/usr/lib/smart-update"
    CONFIG_DIR="/etc/smart-update"
    TOOLS_DIR="/usr/lib/smart-update"
fi

readonly PROJECT_ROOT LIB_DIR CONFIG_DIR TOOLS_DIR

readonly CONFIG_FILE="${CONFIG_DIR}/smart-update.conf"
readonly CONFIG_MODULE="${LIB_DIR}/config.sh"
readonly LOGGER_MODULE="${LIB_DIR}/logger.sh"
readonly DECISION_MODULE="${LIB_DIR}/decision.sh"
readonly EXIT_CODES_MODULE="${LIB_DIR}/exit_codes.sh"
readonly SYSTEM_CHECKS_MODULE="${LIB_DIR}/system_checks.sh"
readonly REPORT_MODULE="${LIB_DIR}/report.sh"
readonly ENGINE_MODULE="${LIB_DIR}/engine.sh"
readonly ARCH_NEWS_CONTEXT_MODULE="${LIB_DIR}/arch_news_context.sh"
readonly PACKAGE_REMOVALS_MODULE="${LIB_DIR}/package_removals.sh"
readonly PACKAGE_REPLACEMENTS_MODULE="${LIB_DIR}/package_replacements.sh"

if [[ -x "${TOOLS_DIR}/package-removals-helper/package-removals-helper" ]]; then
    readonly PACKAGE_REMOVALS_HELPER="${TOOLS_DIR}/package-removals-helper/package-removals-helper"
else
    readonly PACKAGE_REMOVALS_HELPER="${TOOLS_DIR}/package-removals-helper"
fi

readonly LOCK_FILE="/run/lock/smart-update.lock"
readonly STATE_DIR="/var/lib/smart-update"
readonly LAST_SUCCESS_FILE="${STATE_DIR}/last-success"
readonly ARCH_NEWS_STATE_FILE="${STATE_DIR}/arch-news.last"

for required_module in \
    "$CONFIG_MODULE" \
    "$LOGGER_MODULE" \
    "$DECISION_MODULE" \
    "$EXIT_CODES_MODULE" \
    "$SYSTEM_CHECKS_MODULE" \
    "$REPORT_MODULE" \
    "$ENGINE_MODULE" \
    "$ARCH_NEWS_CONTEXT_MODULE" \
    "$PACKAGE_REMOVALS_MODULE" \
    "$PACKAGE_REPLACEMENTS_MODULE"; do

    if [[ ! -r "$required_module" ]]; then
        printf 'Module Smart Update absent : %s\n' "$required_module" >&2
        exit 1
    fi
done

# shellcheck source=lib/config.sh
source "$CONFIG_MODULE"
# shellcheck source=lib/logger.sh
source "$LOGGER_MODULE"
# shellcheck source=lib/decision.sh
source "$DECISION_MODULE"
# shellcheck source=lib/exit_codes.sh
source "$EXIT_CODES_MODULE"
# shellcheck source=lib/system_checks.sh
source "$SYSTEM_CHECKS_MODULE"
# shellcheck source=lib/report.sh
source "$REPORT_MODULE"
# shellcheck source=lib/engine.sh
source "$ENGINE_MODULE"
# shellcheck source=lib/arch_news_context.sh
source "$ARCH_NEWS_CONTEXT_MODULE"
# shellcheck source=lib/package_removals.sh
source "$PACKAGE_REMOVALS_MODULE"
# shellcheck source=lib/package_replacements.sh
source "$PACKAGE_REPLACEMENTS_MODULE"

decision_reset
config_load "$CONFIG_FILE"

install -d -m 0750 "$STATE_DIR"
mkdir -p "$REPORT_DIR"
touch "$LOG_FILE" "$BLOCKED_LOG"
chmod 640 "$LOG_FILE" "$BLOCKED_LOG"

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    decision_add "BLOCK" "Une autre instance de Smart Update est déjà active."
    logger_blocked "${DECISION_REASONS[-1]}"
    exit "$EXIT_INSTANCE_ALREADY_RUNNING"
fi

trap 'logger_error "Erreur ligne ${LINENO} : ${BASH_COMMAND}"' ERR

declare -a UPDATE_LINES=()
declare -a UPDATE_PACKAGES=()
declare -a CRITICAL_UPDATES=()
declare -a NEW_PACKAGES=()
NEW_PACKAGES_ERROR=""
TRANSACTION_SIMULATION=""

load_updates() {
    local output status line package_name
    logger_info "Recherche sécurisée des mises à jour."
    set +e
    output=$(checkupdates 2>&1)
    status=$?
    set -e
    case "$status" in
        0) mapfile -t UPDATE_LINES <<<"$output" ;;
        2) logger_info "Aucune mise à jour disponible."; exit "$EXIT_OK" ;;
        *) logger_error "Échec de checkupdates :"; printf '%s\n' "$output" | tee -a "$LOG_FILE"; exit "$EXIT_CHECKUPDATES_FAILED" ;;
    esac
    for line in "${UPDATE_LINES[@]}"; do
        package_name=${line%% *}
        UPDATE_PACKAGES+=("$package_name")
    done
    logger_info "${#UPDATE_PACKAGES[@]} mise(s) à jour détectée(s)."
    printf '%s\n' "${UPDATE_LINES[@]}" | tee -a "$LOG_FILE"
}

prepare_arch_news_context() {
    arch_news_prepare "$CHECK_ARCH_NEWS" "$ARCH_NEWS_FEED_URL" "$ARCH_NEWS_LIMIT" "$ARCH_NEWS_STATE_FILE" || return 0
}

prepare_package_removals_context() {
    logger_info "Analyse des suppressions prévues par la transaction."
    package_removals_collect "$PACKAGE_REMOVALS_HELPER" || return 0
    logger_info "${#PACKAGE_REMOVALS[@]} suppression(s) prévue(s) par libalpm."
}

prepare_package_replacements_context() {
    logger_info "Analyse des remplacements prévus par la transaction."
    package_replacements_collect "$PACKAGE_REMOVALS_HELPER" || return 0
    logger_info "${#PACKAGE_REPLACEMENTS[@]} remplacement(s) prévu(s) par libalpm."
}

prepare_transaction_context() {
    logger_info "Préparation du contexte de transaction Pacman."
    local status planned_file installed_file new_packages_file
    NEW_PACKAGES=()
    NEW_PACKAGES_ERROR=""
    TRANSACTION_SIMULATION=""
    planned_file=$(mktemp)
    installed_file=$(mktemp)
    new_packages_file=$(mktemp)
    set +e
    TRANSACTION_SIMULATION=$(LC_ALL=C pacman -Syu --print --print-format '%n %v %r' 2>&1)
    status=$?
    set -e
    if ((status != 0)); then
        NEW_PACKAGES_ERROR="La simulation Pacman a échoué."
        logger_error "$NEW_PACKAGES_ERROR"
        printf '%s\n' "$TRANSACTION_SIMULATION" | tee -a "$LOG_FILE" "$BLOCKED_LOG"
        rm -f "$planned_file" "$installed_file" "$new_packages_file"
        return 0
    fi
    printf '%s\n' "$TRANSACTION_SIMULATION" | awk 'NF == 3 && $1 ~ /^[a-zA-Z0-9@._+:-]+$/ {print $1}' | sort -u >"$planned_file"
    pacman -Qq | sort -u >"$installed_file"
    comm -13 "$installed_file" "$planned_file" >"$new_packages_file"
    mapfile -t NEW_PACKAGES <"$new_packages_file"
    logger_info "${#NEW_PACKAGES[@]} nouveau(x) paquet(s) ou nouvelle(s) dépendance(s) détecté(s)."
    rm -f "$planned_file" "$installed_file" "$new_packages_file"
}

persist_arch_news_context() {
    [[ "${ARCH_NEWS_CONTEXT_STATUS:-}" == "NEW" ]] || return 0
    case "${DECISION_FINAL:-}" in ALLOW|WARNING) ;; *) return 0 ;; esac
    if arch_news_state_save "$ARCH_NEWS_STATE_FILE" "$ARCH_NEWS_LATEST_GUID"; then
        logger_info "État Arch News enregistré."
        return 0
    fi
    decision_add "BLOCK" "${ARCH_NEWS_STATE_ERROR:-Impossible d’enregistrer l’état Arch News.}"
    logger_blocked "${DECISION_REASONS[-1]}"
}

simulate_transaction() {
    { echo; echo "Simulation de transaction :"; printf '%s\n' "$TRANSACTION_SIMULATION"; echo; } >>"$LOG_FILE"
}

enforce_final_decision() {
    local gate_status
    if decision_allows_installation; then return 0; else gate_status=$?; fi
    case "$gate_status" in
        1) logger_blocked "Installation interdite par la décision finale BLOCK."; report_finalize "$EXIT_POLICY_BLOCK"; exit "$EXIT_POLICY_BLOCK" ;;
        *) logger_error "Décision finale invalide : ${DECISION_FINAL:-undefined}."; report_finalize "$EXIT_INVALID_FINAL_DECISION"; exit "$EXIT_INVALID_FINAL_DECISION" ;;
    esac
}

install_updates() {
    if [[ "$MODE" == "audit" ]]; then
        logger_info "Mode audit : aucune installation effectuée."
        return 0
    fi
    if [[ "$MODE" != "guarded" ]]; then
        decision_add "BLOCK" "Mode inconnu dans la configuration : ${MODE}"
        logger_blocked "${DECISION_REASONS[-1]}"
        exit "$EXIT_INVALID_MODE"
    fi
    logger_info "Installation de la mise à jour complète des dépôts officiels."
    if ! pacman -Syu --needed </dev/null 2>&1 | tee -a "$LOG_FILE"; then
        decision_add "BLOCK" "Pacman a interrompu ou refusé la transaction."
        logger_blocked "${DECISION_REASONS[-1]}"
        exit "$EXIT_PACMAN_TRANSACTION_FAILED"
    fi
    date --iso-8601=seconds >"$LAST_SUCCESS_FILE"
    chmod 640 "$LAST_SUCCESS_FILE"
    logger_info "Mise à jour terminée avec succès."
}

main() {
    require_root
    check_required_commands
    cleanup_old_reports
    check_network
    check_pacman_lock
    check_root_space
    create_report
    load_updates
    prepare_arch_news_context
    prepare_package_removals_context
    prepare_package_replacements_context
    prepare_transaction_context
    engine_load_policies
    engine_run_policies
    simulate_transaction
    persist_arch_news_context
    enforce_final_decision
    install_updates
    report_finalize "$EXIT_OK"
}

main "$@"
